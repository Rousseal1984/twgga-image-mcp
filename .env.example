# 复制为 .env，填入 key
TWGGA_API_KEY=sk-...
TWGGA_BASEURL=https://twgga.work
TWGGA_MODEL=gpt-image-2

# 可选：TWGGA Grok 图像通道
TWGGA_GROK_API_KEY=sk-...
XAI_MODEL=grok-imagine-image-lite
# Grok 后端不保证精确 WxH；MCP 可在保存前后处理到请求尺寸。
# 可选: contain(默认，补边不裁切) / cover(裁切铺满) / stretch(拉伸) / backend(保留后端原图)
TWGGA_GROK_SIZE_MODE=contain

# API 响应格式策略：
#   auto（默认）— 先 url 请求并下载落盘，失败再重试 API response_format=b64_json
#   url — 仅 url； b64_json — 仅 b64_json
# TWGGA_RESPONSE_FORMAT=auto
# 可信 CDN 域名（逗号分隔）；fake-ip 环境下 URL fallback 下载用
# TWGGA_TRUSTED_DOWNLOAD_HOSTS=oss.filenest.top
# 是否允许可信 CDN 解析到 198.18.0.0/15（Clash/Surge fake-ip）；默认 1
# TWGGA_ALLOW_FAKE_IP_DOWNLOAD=1

# 输出目录（不填默认 ~/Pictures/twgga-out）
# macOS / Linux:
TWGGA_SAVE_DIR=~/Pictures/twgga-out
TWGGA_SAVE_DIR_ROOT=~/Pictures/twgga-out
# Windows (cmd / pwsh):
# TWGGA_SAVE_DIR=%USERPROFILE%\Pictures\twgga-out
# TWGGA_SAVE_DIR_ROOT=%USERPROFILE%\Pictures\twgga-out
